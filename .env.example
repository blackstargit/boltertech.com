# Copy to .env.local for local development. Set the same values in Vercel.

# Absolute site URL, used for canonical tags, OG images and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://boltertech.com

# Resend API key — delivers contact form submissions to contact@boltertech.com.
# Not needed until the contact form is wired up in Phase 1.
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=contact@boltertech.com

# Google Analytics 4 measurement ID. The tag only loads after a visitor
# accepts the cookie banner (src/components/analytics/ConsentBanner.tsx).
# Leave unset in preview/local environments to keep that traffic out of GA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
